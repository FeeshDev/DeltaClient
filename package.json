{
  "name": "brclient",
  "version": "2.2.0",
  "description": "BRClient for BuildRoyale.io",
  "main": "src/main.js",
  "scripts": {
    "start": "electron .",
    "pack": "electron-builder --dir",
    "dist": "electron-builder",
    "publish": "electron-builder -p always"
  },
  "keywords": [],
  "author": "Feesh",
  "license": "ISC",
  "engines": {
    "node": ">=22.12.0"
  },
  "build": {
    "productName": "BRClient",
    "appId": "com.github.FeeshDev.deltaclient",
    "compression": "normal",
    "publish": [
      {
        "provider": "github",
        "owner": "FeeshDev",
        "repo": "DeltaClient"
      }
    ],
    "files": [
      "build/**",
      "public/**",
      "src/**.js",
      "package.json"
    ],
    "directories": {
      "buildResources": "build",
      "output": "dist/${version}/${platform}/"
    },
    "win": {
      "icon": "build/br.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "runAfterFinish": false,
      "installerIcon": "build/installer.ico",
      "uninstallerIcon": "build/installer.ico"
    }
  },
  "devDependencies": {
    "electron": "^45.0.0",
    "electron-builder": "^26.15.3"
  },
  "dependencies": {
    "discord-rpc": "^4.0.1",
    "electron-log": "^5.4.4",
    "electron-updater": "^6.8.9"
  }
}
